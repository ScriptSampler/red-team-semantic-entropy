@inproceedings{obadinma2025verbal,
  title     = {On the Robustness of Verbal Confidence of {LLMs} in Adversarial Attacks},
  author    = {Obadinma, Stephen and Zhu, Xiaodan},
  booktitle = {Advances in Neural Information Processing Systems (NeurIPS)},
  year      = {2025},
  annote    = {arXiv:2507.06489. THE CLOSEST INPUT-SIDE NEIGHBOUR and the most likely reviewer objection to our novelty claim: semantic-preserving perturbations that degrade an LLM's uncertainty estimate. DISTINGUISH: the victim is the model's PROMPTED SELF-REPORTED (verbal) confidence, not entropy over a sampled answer set clustered by meaning; there is no bidirectional-NLI equivalence gate; and their attacks change answers frequently whereas our success criterion REQUIRES the hallucination status to survive. Title/authors/venue verified on arXiv 2026-08-03.}
}

