@article{kuhn2023semantic,
  title   = {Semantic Uncertainty: Linguistic Invariances for Uncertainty Estimation in Natural Language Generation},
  author  = {Kuhn, Lorenz and Gal, Yarin and Farquhar, Sebastian},
  journal = {International Conference on Learning Representations (ICLR)},
  year    = {2023},
  annote    = {arXiv:2302.09664. Origin of semantic entropy; the linguistic-invariance claim
this project attacks. ESTIMATOR CAVEAT, verified against the full text 2026-08-13: their
Eq. (4) is "SE(x) ~ -|C|^-1 sum_{i=1}^{|C|} log p(C_i|x)" with p(c|x) = sum_{s in c} p(s|x)
over LENGTH-NORMALISED sequence likelihoods and NO renormalisation across clusters. It is an
average of surprisals, not a plug-in categorical entropy, and it is therefore NOT bounded by
log N --- it diverges upward as any cluster likelihood tends to zero, and length normalisation
can push cluster mass above one (the degeneracy Farquhar's Eq. (5) normalisation was added to
remove). Even renormalised, Jensen puts a uniform average of -log P(C_i|x) AT OR ABOVE
log|C|. So the log N ceiling may NOT be stated for "semantic entropy" unqualified; writing
"discrete" once is not enough, which is why Methods separates all three estimators.}
}

@article{farquhar2024detecting,
  title   = {Detecting Hallucinations in Large Language Models Using Semantic Entropy},
  author  = {Farquhar, Sebastian and Kossen, Jannik and Kuhn, Lorenz and Gal, Yarin},
  journal = {Nature},
  volume  = {630},
  year    = {2024},
  annote    = {The SE detector. Primary victim method. ESTIMATOR SCOPE, verified against the
Nature full text 2026-08-13 (PMC11186750) --- do not re-litigate without re-reading it.
THREE estimators exist and we implement the third. Eq. (5) is the likelihood-weighted one and
is explicitly NORMALISED: "P(C_i|x) = P(c_i|x)/sum_c P(c|x) estimates a categorical
distribution over the cluster meanings, that is, sum_i P(C_i|x) = 1. Without this
normalization step cluster 'probabilities' could exceed one because of length normalization,
resulting in degeneracies." And: "Equation (5) is the estimator giving our main method that we
refer to as semantic entropy throughout the text." THEY NAME OURS: "For scenarios in which the
sequence probabilities are not available, we propose a variant of semantic entropy which we
call 'discrete' semantic entropy", which "approximates P(C_i|x) directly from the number of
generations in each cluster, disregarding the token probabilities" --- and decisively, it is
the estimator "which we use for all GPT-4 results in this paper and which performs similarly
well." CONSEQUENCE: the log N ceiling DOES carry to Eq. (5) (normalised categorical entropy
over the same at most N observed clusters, so provably in [0, log K] subset [0, log N]); the
39-point lattice, the 0.139-nat gap, the unwinnable-denominator count and the hard-tie
machinery DO NOT. Whether the empirical pile-up carries is UNSETTLED (Limitations).}
}

